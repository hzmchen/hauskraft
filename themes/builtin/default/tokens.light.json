{
  "color": {
    "$type": "color",
    "background": {
      "$value": "#ffffff"
    },
    "foreground": {
      "$value": "#0f172a"
    },
    "surface": {
      "$value": "#f8fafc"
    },
    "surface-foreground": {
      "$value": "#0f172a"
    },
    "muted": {
      "$value": "#f1f5f9"
    },
    "muted-foreground": {
      "$value": "#475569"
    },
    "border": {
      "$value": "#7b8698"
    },
    "input": {
      "$value": "#6b7789"
    },
    "ring": {
      "$value": "#2563eb"
    },
    "overlay": {
      "$value": "#0f172a99"
    },
    "primary": {
      "$value": "#2563eb"
    },
    "primary-foreground": {
      "$value": "#ffffff"
    },
    "secondary": {
      "$value": "#e2e8f0"
    },
    "secondary-foreground": {
      "$value": "#0f172a"
    },
    "accent": {
      "$value": "#dbeafe"
    },
    "accent-foreground": {
      "$value": "#1e3a8a"
    },
    "destructive": {
      "$value": "#dc2626"
    },
    "destructive-foreground": {
      "$value": "#ffffff"
    },
    "success": {
      "$value": "#15803d"
    },
    "success-foreground": {
      "$value": "#ffffff"
    },
    "warning": {
      "$value": "#b45309"
    },
    "warning-foreground": {
      "$value": "#ffffff"
    },
    "info": {
      "$value": "#0369a1"
    },
    "info-foreground": {
      "$value": "#ffffff"
    },
    "nav-background": {
      "$value": "#f8fafc"
    },
    "nav-foreground": {
      "$value": "#0f172a"
    },
    "nav-active": {
      "$value": "#2563eb"
    },
    "nav-active-foreground": {
      "$value": "#ffffff"
    },
    "widget-background": {
      "$value": "#ffffff"
    },
    "widget-foreground": {
      "$value": "#0f172a"
    },
    "widget-border": {
      "$value": "#cbd5e1"
    },
    "chart-1": {
      "$value": "#2563eb"
    },
    "chart-2": {
      "$value": "#16a34a"
    },
    "chart-3": {
      "$value": "#d97706"
    },
    "chart-4": {
      "$value": "#9333ea"
    },
    "chart-5": {
      "$value": "#db2777"
    },
    "chart-6": {
      "$value": "#0891b2"
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": ["Inter", "system-ui", "sans-serif"]
    },
    "heading": {
      "$value": "{font.sans}"
    },
    "mono": {
      "$value": ["ui-monospace", "SFMono-Regular", "monospace"]
    }
  },
  "font-size": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 0.875,
        "unit": "rem"
      }
    },
    "base": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 1.125,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 1.25,
        "unit": "rem"
      }
    },
    "2xl": {
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "3xl": {
      "$value": {
        "value": 1.875,
        "unit": "rem"
      }
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "medium": {
      "$value": 500
    },
    "bold": {
      "$value": 700
    }
  },
  "line-height": {
    "$type": "number",
    "tight": {
      "$value": 1.2
    },
    "normal": {
      "$value": 1.5
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "unit": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": "#0f172a1a",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "md": {
      "$value": {
        "color": "#0f172a26",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 6,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "lg": {
      "$value": {
        "color": "#0f172a33",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 8,
          "unit": "px"
        },
        "blur": {
          "value": 24,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "normal": {
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [0.2, 0, 0, 1]
    }
  }
}
