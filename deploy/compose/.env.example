# SPDX-License-Identifier: AGPL-3.0-or-later
# Copy to `.env` in the repository root and adjust. Every value has a demo default in compose.yaml.

# Required in production (HEARTHOS_ENV=production): at least 32 random characters,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`. Never commit it.
HEARTHOS_SECRET_KEY=
# development (default for the demo) or production
HEARTHOS_ENV=development
# true when served over HTTPS
HEARTHOS_COOKIE_SECURE=false
# The address people open; writes from other origins are refused
HEARTHOS_ALLOWED_ORIGINS=http://localhost:8080
# The household theme until an adult picks another in Settings → Appearance
HEARTHOS_DEFAULT_THEME=org.hearthos.theme.default
# Port of the web front door on this machine
HEARTHOS_WEB_PORT=8080
# Seed the demo household (users demo/alex, password hearthos-demo) into an empty database
HEARTHOS_SEED_DEMO=true
