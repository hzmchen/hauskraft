# SPDX-License-Identifier: AGPL-3.0-or-later
# Copy to `.env` in the repository root and adjust. Every value has a demo default in compose.yaml.

# Required in production (HAUSKRAFT_ENV=production): at least 32 random characters,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`. Never commit it.
HAUSKRAFT_SECRET_KEY=
# development (default for the demo) or production
HAUSKRAFT_ENV=development
# true when served over HTTPS
HAUSKRAFT_COOKIE_SECURE=false
# The address people open; writes from other origins are refused
HAUSKRAFT_ALLOWED_ORIGINS=http://localhost:8080
# The household theme until an owner picks another in Settings → Appearance
HAUSKRAFT_DEFAULT_THEME=dev.hauskraft.theme.default
# Port of the web front door on this machine
HAUSKRAFT_WEB_PORT=8080
# Address the web front door listens on. The default, 127.0.0.1, keeps a fresh install reachable only from
# this machine, so nobody else can finish the setup and become the owner (ADR 0017). Use 0.0.0.0 to open it
# to your network only behind TLS (a reverse proxy with HTTPS) and with HAUSKRAFT_COOKIE_SECURE=true:
# without TLS, passwords and session cookies cross the network in clear text (spec §11.3).
HAUSKRAFT_WEB_BIND=127.0.0.1
# Seed the demo household (users demo/alex, password hauskraft-demo) into an empty database
HAUSKRAFT_SEED_DEMO=true
