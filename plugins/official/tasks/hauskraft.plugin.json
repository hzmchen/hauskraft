{
  "$schema": "../../../packages/schemas/manifest/hauskraft.plugin.schema.json",
  "id": "dev.hauskraft.tasks",
  "name": "Tasks",
  "version": "0.1.0",
  "type": ["domain", "widget"],
  "hauskraft_api": "^0.1.0",
  "license": "MIT",
  "authors": [
    {
      "name": "Hauskraft contributors"
    }
  ],
  "source": "https://github.com/hzmchen/hauskraft/tree/main/plugins/official/tasks",
  "runtime": {
    "kind": "inprocess",
    "entrypoint": "hauskraft_tasks.plugin:plugin",
    "api_prefix": "/tasks",
    "migrations": "backend/migrations/versions",
    "web": "@hauskraft/plugin-tasks"
  },
  "capabilities": ["graph:read:Task", "graph:write:Task", "events:emit:hauskraft.task.*"],
  "data_classes": {
    "reads": ["household"],
    "writes": ["household"],
    "emits": ["household"]
  },
  "config_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "contributes": {
    "widgets": [
      {
        "id": "tasks.list",
        "title": "i18n:tasks:widget.title",
        "component": "TasksWidget",
        "default_size": {
          "w": 4,
          "h": 6
        },
        "min_size": {
          "w": 3,
          "h": 4
        }
      }
    ],
    "pages": [
      {
        "id": "tasks",
        "title": "i18n:tasks:page.title",
        "component": "TasksPage",
        "nav": true,
        "icon": "nav.tasks",
        "nav_order": 20
      }
    ],
    "entities": [
      {
        "type": "Task",
        "data_class": "household"
      }
    ],
    "icons": [],
    "tools": [
      {
        "name": "tasks.list",
        "description": "List the household's tasks, newest first: id, title, done, due date. Use it to find a task's id.",
        "annotations": {
          "read_only": true,
          "destructive": false,
          "idempotent": true,
          "open_world": false
        },
        "data_class": "household",
        "permission": "task.read"
      },
      {
        "name": "tasks.create",
        "description": "Add a task to the household's shared list, optionally with a due date.",
        "annotations": {
          "read_only": false,
          "destructive": false,
          "idempotent": false,
          "open_world": false
        },
        "data_class": "household",
        "permission": "task.create"
      },
      {
        "name": "tasks.update",
        "description": "Change a task: rename it, mark it done or open again, or set or clear its due date.",
        "annotations": {
          "read_only": false,
          "destructive": false,
          "idempotent": true,
          "open_world": false
        },
        "data_class": "household",
        "permission": "task.update"
      },
      {
        "name": "tasks.delete",
        "description": "Delete a task for good. The app asks the person before it runs.",
        "annotations": {
          "read_only": false,
          "destructive": true,
          "idempotent": true,
          "open_world": false
        },
        "data_class": "household",
        "permission": "task.delete"
      }
    ],
    "settings": [],
    "commands": [],
    "themes": [],
    "agent_guidance": "Tasks are the household's shared to-do list. Due dates are calendar dates in the household time zone (the context block's 'Today:' line); 'tomorrow' is that date plus one day. Find a task's id with tasks.list before changing it; never guess ids.",
    "skills": [
      {
        "id": "add-from-text",
        "path": "skills/add-from-text/SKILL.md"
      },
      {
        "id": "weekly-overview",
        "path": "skills/weekly-overview/SKILL.md"
      }
    ]
  },
  "subscribes": []
}
