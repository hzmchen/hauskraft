{
  "$schema": "../../../packages/schemas/manifest/hearthos.plugin.schema.json",
  "id": "org.hearthos.tasks",
  "name": "Tasks",
  "version": "0.1.0",
  "type": ["domain", "widget"],
  "hearthos_api": "^0.1.0",
  "license": "MIT",
  "authors": [
    {
      "name": "HearthOS contributors"
    }
  ],
  "source": "https://github.com/hearthos/hearthos/tree/main/plugins/official/tasks",
  "runtime": {
    "kind": "inprocess",
    "entrypoint": "hearthos_tasks.plugin:plugin",
    "api_prefix": "/tasks",
    "migrations": "backend/migrations/versions",
    "web": "@hearthos/plugin-tasks"
  },
  "capabilities": ["graph:read:Task", "graph:write:Task", "events:emit:hearthos.task.*"],
  "data_classes": {
    "reads": ["household"],
    "writes": ["household"],
    "emits": ["household"]
  },
  "config_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "contributes": {
    "widgets": [
      {
        "id": "tasks.list",
        "title": "i18n:tasks:widget.title",
        "component": "TasksWidget",
        "default_size": {
          "w": 4,
          "h": 6
        },
        "min_size": {
          "w": 3,
          "h": 4
        }
      }
    ],
    "pages": [
      {
        "id": "tasks",
        "title": "i18n:tasks:page.title",
        "component": "TasksPage",
        "nav": true,
        "icon": "nav.tasks",
        "nav_order": 20
      }
    ],
    "entities": [
      {
        "type": "Task",
        "data_class": "household"
      }
    ],
    "icons": [],
    "tools": [],
    "settings": [],
    "commands": [],
    "themes": []
  },
  "subscribes": []
}
