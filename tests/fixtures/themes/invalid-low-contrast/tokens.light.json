{
  "color": {
    "$type": "color",
    "background": {
      "$value": "#ffffff"
    },
    "foreground": {
      "$value": "#111827"
    },
    "surface": {
      "$value": "#f8fafc"
    },
    "surface-foreground": {
      "$value": "#111827"
    },
    "muted": {
      "$value": "#f1f5f9"
    },
    "muted-foreground": {
      "$value": "#cbd5e1"
    },
    "border": {
      "$value": "#64748b"
    },
    "input": {
      "$value": "#64748b"
    },
    "ring": {
      "$value": "#1d4ed8"
    },
    "overlay": {
      "$value": "#0f172acc"
    },
    "primary": {
      "$value": "#1d4ed8"
    },
    "primary-foreground": {
      "$value": "#ffffff"
    },
    "secondary": {
      "$value": "#e2e8f0"
    },
    "secondary-foreground": {
      "$value": "#0f172a"
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.427,
          0.157,
          0.851
        ],
        "alpha": 1
      }
    },
    "accent-foreground": {
      "$value": "#ffffff"
    },
    "destructive": {
      "$value": "#b91c1c"
    },
    "destructive-foreground": {
      "$value": "#ffffff"
    },
    "success": {
      "$value": "#15803d"
    },
    "success-foreground": {
      "$value": "#ffffff"
    },
    "warning": {
      "$value": "#fbbf24"
    },
    "warning-foreground": {
      "$value": "#111827"
    },
    "info": {
      "$value": "#0369a1"
    },
    "info-foreground": {
      "$value": "#ffffff"
    },
    "nav-background": {
      "$value": "#f1f5f9"
    },
    "nav-foreground": {
      "$value": "#0f172a"
    },
    "nav-active": {
      "$value": "#1d4ed8"
    },
    "nav-active-foreground": {
      "$value": "#ffffff"
    },
    "widget-background": {
      "$value": "#ffffff"
    },
    "widget-foreground": {
      "$value": "#111827"
    },
    "widget-border": {
      "$value": "#64748b"
    },
    "chart-1": {
      "$value": "#1d4ed8"
    },
    "chart-2": {
      "$value": "#15803d"
    },
    "chart-3": {
      "$value": "#b45309"
    },
    "chart-4": {
      "$value": "#7c3aed"
    },
    "chart-5": {
      "$value": "#be123c"
    },
    "chart-6": {
      "$value": "#0e7490"
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "Fixture Sans",
        "system-ui",
        "sans-serif"
      ]
    },
    "heading": {
      "$value": "{font.sans}"
    },
    "mono": {
      "$value": [
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "font-size": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 0.875,
        "unit": "rem"
      }
    },
    "base": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 1.125,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 1.25,
        "unit": "rem"
      }
    },
    "2xl": {
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "3xl": {
      "$value": {
        "value": 1.875,
        "unit": "rem"
      }
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "medium": {
      "$value": 500
    },
    "bold": {
      "$value": 700
    }
  },
  "line-height": {
    "$type": "number",
    "tight": {
      "$value": 1.2
    },
    "normal": {
      "$value": 1.5
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "unit": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": "#0000001a",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "md": {
      "$value": {
        "color": "#00000026",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 6,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "lg": {
      "$value": {
        "color": "#00000033",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 8,
          "unit": "px"
        },
        "blur": {
          "value": 24,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "normal": {
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    }
  }
}
