{
  "id": "org.hearthos.tasks",
  "name": "Tasks",
  "version": "0.1.0",
  "type": [
    "domain",
    "widget"
  ],
  "hearthos_api": "^0.1.0",
  "license": "MIT",
  "authors": [
    {
      "name": "HearthOS contributors"
    }
  ],
  "source": "https://example.org/tasks",
  "runtime": {
    "kind": "inprocess",
    "entrypoint": "hearthos_tasks.plugin:plugin",
    "api_prefix": "/tasks",
    "migrations": "backend/migrations/versions",
    "web": "@hearthos/plugin-tasks"
  },
  "capabilities": [
    "graph:read:Task",
    "graph:write:Task",
    "events:emit:hearthos.task.*"
  ],
  "data_classes": {
    "reads": [
      "household"
    ],
    "writes": [
      "household"
    ],
    "emits": [
      "household"
    ]
  },
  "contributes": {
    "widgets": [
      {
        "id": "tasks.list",
        "title": "i18n:tasks:widget.title",
        "component": "TasksWidget",
        "default_size": {
          "w": 4,
          "h": 6
        },
        "min_size": {
          "w": 3,
          "h": 4
        }
      }
    ],
    "pages": [
      {
        "id": "tasks",
        "title": "i18n:tasks:page.title",
        "component": "TasksPage",
        "nav": true,
        "icon": "nav.tasks",
        "nav_order": 20
      }
    ],
    "icons": [
      {
        "name": "tasks.priority",
        "svg": "web/icons/priority.svg"
      }
    ],
    "entities": [
      {
        "type": "Task",
        "data_class": "household"
      }
    ]
  }
}
