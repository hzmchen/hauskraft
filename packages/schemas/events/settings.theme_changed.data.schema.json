  "$comment": "SPDX-License-Identifier: MIT",
  "title": "hauskraft.settings.theme_changed data",
  "type": "object",
  "required": ["from", "to"],
  "additionalProperties": false,
  "properties": {
    "from": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+(:[a-z0-9-]+)?$"
    },
    "to": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+(:[a-z0-9-]+)?$"
    }
  }
}
