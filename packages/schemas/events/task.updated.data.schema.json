{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hearthos.org/events/task.updated/v1.json",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "hearthos.task.updated data",
  "type": "object",
  "required": ["task", "changes"],
  "additionalProperties": false,
  "properties": {
    "task": {
      "$ref": "https://schemas.hearthos.org/events/task.created/v1.json#/$defs/task"
    },
    "changes": {
      "description": "Changed fields as [old, new]; reopening appears as done: [true, false].",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "due_on": {
          "type": "array",
          "prefixItems": [
            {
              "type": ["string", "null"],
              "format": "date"
            },
            {
              "type": ["string", "null"],
              "format": "date"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "done": {
          "type": "array",
          "prefixItems": [
            {
              "type": "boolean"
            },
            {
              "type": "boolean"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
